# All backend calls go through Gateway. No private service port is used by this frontend.
GATEWAY_URL=http://127.0.0.1:8080
# true = clearly marked example catalog, no purchases sent to backend.
# false = real Product/Inventory/Order APIs; no mock fallback on failures.
DEMO_CATALOG=false
# Set true behind a production HTTPS proxy.
COOKIE_SECURE=false
