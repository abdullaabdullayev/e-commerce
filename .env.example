# Copy to .env. Keep DB/Rabbit credentials consistent with existing volumes.
DB_USERNAME=my_username
DB_PASSWORD=my_password
RABBITMQ_USERNAME=my_rabbit_user
RABBITMQ_PASSWORD=my_rabbit_password

# Fill each with a separate, randomly generated secret before starting Compose.
# SECRET_KEY is shared only by Auth and Order; use at least 32 bytes.
SECRET_KEY=
CATALOG_ADMIN_KEY=
INVENTORY_SERVICE_KEY=
ORDER_SERVICE_KEY=

ACCESS_EXPIRATION=900000
REFRESH_EXPIRATION=604800000
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080
