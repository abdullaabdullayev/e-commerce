# Copy to .env and replace every placeholder before running `docker compose up`.
# Secrets must be at least 32 random characters, e.g. generate one with:
#   openssl rand -base64 48

# --- Shared database credentials (each service can override with <SERVICE>_DB_USERNAME / _PASSWORD)
DB_USERNAME=app
DB_PASSWORD=change-me-db-password

# --- RabbitMQ
RABBITMQ_USERNAME=app
RABBITMQ_PASSWORD=change-me-rabbit-password

# --- JWT (shared by auth, user, order, course and product services)
SECRET_KEY=change-me-to-a-random-secret-of-at-least-32-chars
ACCESS_EXPIRATION=900000
REFRESH_EXPIRATION=604800000

# --- Service-to-service keys
AUTH_BOOTSTRAP_KEY=change-me-auth-bootstrap-key
PROFILE_SERVICE_KEY=change-me-profile-service-key
CATALOG_ADMIN_KEY=change-me-catalog-admin-key
INVENTORY_SERVICE_KEY=change-me-inventory-service-key
ORDER_SERVICE_KEY=change-me-order-service-key

# --- Course material storage (S3-compatible SeaweedFS)
COURSE_STORAGE_ACCESS_KEY=course-storage
COURSE_STORAGE_SECRET_KEY=change-me-course-storage-secret

# --- Optional
# GATEWAY_PORT=8080
# CORS_ALLOWED_ORIGINS=http://localhost:3000
