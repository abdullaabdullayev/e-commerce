# Add these keys to the repository root .env; replace every blank value.
# Use at least 32 random characters for each secret. Keep existing DB/JWT keys.
AUTH_BOOTSTRAP_KEY=
PROFILE_SERVICE_KEY=
COURSE_STORAGE_ACCESS_KEY=kodariun-course
COURSE_STORAGE_SECRET_KEY=
# Optional IDE overrides; Docker sets its own internal endpoints.
COURSE_DB_URL=jdbc:postgresql://localhost:5436/course_db
COURSE_STORAGE_ENDPOINT=http://localhost:9000
COURSE_STORAGE_BUCKET=course-materials
